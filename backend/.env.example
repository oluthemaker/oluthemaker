# Required existing application settings
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/olu-the-maker
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173

# Flutterwave (use test credentials in development)
FLW_PUBLIC_KEY=FLWPUBK_TEST-REPLACE_ME
FLW_SECRET_KEY=FLWSECK_TEST-REPLACE_ME
FLW_SECRET_HASH=replace-with-the-webhook-secret-hash

# Currency and order pricing
# Product catalogue prices are stored in NGN. Set NGN_PER_USD to the approved
# store conversion rate (NGN for 1 USD). USD checkout is intentionally disabled
# until this is configured; do not use a guessed or stale rate.
NGN_PER_USD=
SHIPPING_PRICE_NGN=0
# Decimal fraction: 0.075 means 7.5%; keep 0 if tax is not being calculated here.
ORDER_TAX_RATE=0

# Optional existing services
RESEND_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
